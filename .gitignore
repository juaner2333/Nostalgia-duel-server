# ==========================================
# .gitignore
# ==========================================

# Environments & Secrets
.env
.env.*
!.env.example
certs/

# Dependencies & Build
node_modules/
dist/
coverage/
*.log
app.log

# Databases & Data
postgres_data/
*databases/
*.db
*.cdb
*banlists/

# Project configuration
*.conf

# Agent tooling (local skill-registry cache)
.atl/
.pi/

# VS Code & IDEs
.vscode/
.idea/
.DS_Store

# Qoder IDE (local settings)
.qoder/

# Mercury
mercury/script/
mercury/scripts/
mercury/alternatives/
mercury/ocg/
mercury/pre-releases/ocg/*
!mercury/pre-releases/ocg/ygopro
mercury/pre-releases/tcg/*
!mercury/pre-releases/tcg/ygopro

# Git Submodules & Repositories
*repositories/

# Miscellaneous Directories
dependencies/
build/

mycard

# Reviewed fixed assets for the two nostalgia formats. Keep the broad generated
# resource rules above; only these committed inputs and generated outputs escape.
!nostalgia-resources/**/*.cdb
!nostalgia-resources/**/*.conf

# Local bats-core installation (not a repo dependency)
tools/

# Local session + fetched core artifact (not versioned)
.claude/
/ocgcore-worker
