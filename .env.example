  # ── Cloud deployment (docker-compose.cloud.yaml) ──
  # Mirror full name <registry>/<namespace>/nostalgia-duel-server:<git-tag>.
  # Registry prefix may differ per environment; repo suffix and tag must match the release.
  SERVER_IMAGE=ccr.ccs.tencentyun.com/nostalgia-duel-server/nostalgia-duel-server:1.0.0

  # ── Server Ports ──
  YGOPRO_PORT=706
  HTTP_PORT=7922
  WEBSOCKET_PORT=4000

  # ── YGOPro Card Resources ──
  # Fixed 1103/1109 resources are bundled with the app at ./nostalgia-resources.
  # They are validated in full at startup and ship inside the Docker image;
  # there is no manifest, no resource version to configure and no runtime
  # refresh. RESOURCES_DIR may be set to override the bundled root in local dev.

  # ── Database ──
  POSTGRES_HOST=localhost
  POSTGRES_PORT=5432
  POSTGRES_DB=evolution
  POSTGRES_USER=evolution
  POSTGRES_PASSWORD=your-postgres-password

  # ── Redis / Valkey ──
  USE_REDIS=false
  REDIS_URI=redis://localhost:6379

  # ── Ranking ──
  RANK_ENABLED=false
  SEASON=5

  # ── Rate Limiting ──
  RATE_LIMIT_ENABLED=true
  RATE_LIMIT=3
  RATE_LIMIT_WINDOW=300

  # ── Misc ──
  NODE_ENV=development
  ADMIN_API_KEY=your-admin-api-key
  SIDE_TIMEOUT_MINUTES=3
