+void field::apply_summon_position_lock(card* target, uint8_t summon_destination) {
+	// The turn player's idle command checks only their own monsters.
+	// Skip the summon lock for a monster the opponent summoned to their own field.
+	if((core.duel_options & DUEL_CHANGE_STOLEN_SUMMON_POSITION)
+		&& target->summon_player != infos.turn_player
+		&& target->summon_player == summon_destination)
+		return;
+	target->set_status(STATUS_CANNOT_CHANGE_FORM, TRUE);
