# ==========================================
# .dockerignore
# ==========================================

# Git
.git/
.gitignore
.gitmodules

# Environments & Secrets
.env
.env.*
!.env.example
certs/

# Dependencies & Build
node_modules/
dist/
coverage/
*.log
app.log

# Databases & Data
postgres_data/
*databases/
*.db
*.cdb
*banlists/
!nostalgia-resources/**/*.cdb

# Project configuration
*.conf
!nostalgia-resources/**/*.conf

# VS Code & IDEs
.vscode/
.idea/
.DS_Store

# Mercury
mercury/script/
mercury/scripts/
mercury/alternatives/
mercury/ocg/
mercury/pre-releases/ocg/*
!mercury/pre-releases/ocg/ygopro
mercury/pre-releases/tcg/*
!mercury/pre-releases/tcg/ygopro

# Legacy resource pipeline artifacts (repositories cache, assembled releases)
*repositories/

# Miscellaneous Directories
dependencies/
build/

# Miscellaneous Files
Dockerfile
docker-compose*.yaml
README.md
CHANGELOG.md
.github/CONTRIBUTING.md
.github/CODE_OF_CONDUCT.md
